<view class="minePage">
  <view class="bgBox">
    <image src="http://39.106.44.146/WULIU/mine0.png" mode="" style="width: 100%; height: 540rpx;" />
    <!-- 头像 昵称 -->
    <view class="avatarBox">
      <view class="avatarBgBox frcc">
        <image wx:if="{{ !isLogin}}" src="http://39.106.44.146/WULIU/mine1.png" mode="" style="width: 180rpx; height: 180rpx; border-radius: 180rpx;" bind:tap="goLogin" />
        <image wx:if="{{ isLogin && profile.role === 1 }}" src="http://39.106.44.146/WULIU/mine3.png" mode="" style="width: 180rpx; height: 180rpx; border-radius: 180rpx;" />
        <image wx:if="{{ isLogin && profile.role === 2 }}" src="http://39.106.44.146/WULIU/mine2.png" mode="" style="width: 180rpx; height: 180rpx; border-radius: 180rpx;" />
      </view>
      <view wx:if="{{ !isLogin}}" class="nickName frcc" bind:tap="goLogin">点击登录</view>
      <view wx:if="{{ isLogin && profile.role === 1 }}" class="nickName frcc">{{ profile.screen_name }}</view>
      <view wx:if="{{ isLogin && profile.role === 2 }}" class="nickName frcc">{{ profile.name }}</view>
    </view>
  </view>
  <view class="cardBox">
    <!-- 待签合同 -->
    <view wx:if="{{ isLogin && profile.role === 2 }}" class="cardItem frbc" bind:tap="goHetong">
      <view class="frcc">
        <image src="/images/mineModule/mine_dqht.png" mode="" style="width: 36rpx; height: 36rpx;" />
        <view class="titleText">待签合同</view>
      </view>
      <view class="frcc">
        <view class="placeholderText">查看</view>
        <image src="/images/homeModule/homeMore.png" mode="" style="width: 30rpx; height: 30rpx;" />
      </view>
    </view>
    <!-- 我的货单 -->
    <view wx:if="{{ isLogin && profile.role === 1 }}" class="cardItem frbc" bind:tap="goHuodan">
      <view class="frcc">
        <image src="/images/mineModule/mine_wdhd.png" mode="" style="width: 36rpx; height: 36rpx;" />
        <view class="titleText">我的货单</view>
      </view>
      <view class="frcc">
        <view class="placeholderText">查看</view>
        <image src="/images/homeModule/homeMore.png" mode="" style="width: 30rpx; height: 30rpx;" />
      </view>
    </view>
    <!-- 货单运费 -->
    <view wx:if="{{ isLogin && profile.role === 1 }}" class="cardItem frbc" bind:tap="goHuodanYf">
      <view class="frcc">
        <image src="/images/mineModule/mine_wdhd.png" mode="" style="width: 36rpx; height: 36rpx;" />
        <view class="titleText">货单运费</view>
      </view>
      <view class="frcc">
        <view class="placeholderText">查看</view>
        <image src="/images/homeModule/homeMore.png" mode="" style="width: 30rpx; height: 30rpx;" />
      </view>
    </view>
    <!-- 荣程货源 -->
    <view wx:if="{{ isLogin && profile.role === 1 }}" class="cardItem frbc" bind:tap="goHouyuan">
      <view class="frcc">
        <image src="/images/mineModule/mine_rchy.png" mode="" style="width: 36rpx; height: 36rpx;" />
        <view class="titleText">荣程货源</view>
      </view>
      <view class="frcc">
        <view class="placeholderText">查看</view>
        <image src="/images/homeModule/homeMore.png" mode="" style="width: 30rpx; height: 30rpx;" />
      </view>
    </view>
    <!-- 用户须知 -->
    <view class="cardItem frbc" bind:tap="goPagecontent">
      <view class="frcc">
        <image src="/images/mineModule/mine_yhxz.png" mode="" style="width: 36rpx; height: 36rpx;" />
        <view class="titleText">用户须知</view>
      </view>
      <view class="frcc">
        <view wx:if="{{ !isLogin }}" class="placeholderText">请登录</view>
        <view wx:else class="placeholderText">详情</view>
        <image src="/images/homeModule/homeMore.png" mode="" style="width: 30rpx; height: 30rpx;" />
      </view>
    </view>
    <!-- 绑定车辆 -->
    <view wx:if="{{ isLogin && profile.role === 1 }}" class="cardItem frbc" bind:tap="goCarList">
      <view class="frcc">
        <image src="/images/mineModule/mine_wdzl.png" mode="" style="width: 36rpx; height: 36rpx;" />
        <view class="titleText">绑定车辆</view>
      </view>
      <view class="frcc">
        <view class="placeholderText">详情</view>
        <image src="/images/homeModule/homeMore.png" mode="" style="width: 30rpx; height: 30rpx;" />
      </view>
    </view>
    <!-- 我的资料 -->
    <!-- <view wx:if="{{ isLogin && profile.role === 1 }}" class="cardItem frbc">
      <view class="frcc">
        <image src="/images/mineModule/mine_wdzl.png" mode="" style="width: 36rpx; height: 36rpx;" />
        <view class="titleText">我的资料</view>
      </view>
      <view class="frcc">
        <view class="placeholderText">查看</view>
        <image src="/images/homeModule/homeMore.png" mode="" style="width: 30rpx; height: 30rpx;" />
      </view>
    </view> -->
    <!-- 联系客服 -->
    <view class="cardItem frbc">
      <view class="frcc">
        <image src="/images/mineModule/mine_lxkf.png" mode="" style="width: 36rpx; height: 36rpx;" />
        <view class="titleText">联系客服</view>
        <button wx:if="{{ isLogin }}" open-type="contact" class="zxkfBtn">咨询客服</button>
      </view>
      <view class="frcc">
        <view wx:if="{{ !isLogin }}" class="placeholderText">请登录</view>
        <view wx:else class="placeholderText">点击咨询</view>
        <image src="/images/homeModule/homeMore.png" mode="" style="width: 30rpx; height: 30rpx;" />
      </view>
    </view>
  </view>
</view>