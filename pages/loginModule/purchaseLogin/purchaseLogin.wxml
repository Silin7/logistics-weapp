<view class="purchaseLogin">
  <view class="topBox frbc">
    <view>
      <view class="hyzcText">欢迎注册</view>
      <view class="tipsText">登录后更精彩</view>
    </view>
    <image src="https://huayueit-02.oss-cn-hangzhou.aliyuncs.com/rongcheng/logincgs.png" mode="" style="width: 380rpx; height: 275rpx;" />
  </view>
  <!-- 登录卡片 -->
  <view class="cardBox">
    <view class="labelText">手机号</view>
    <button class="phoneBtn" hover-class="none" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">
      <text wx:if="{{ userPhone }}" class="phoneText">{{ userPhone }}</text>
      <text wx:else class="phonePlaceholder">点击获取手机号</text>
    </button>
    <view class="submitClass frcc" bind:tap="submitFunction">提交</view>
  </view>
</view>