.purchaseLogin {
  position: relative;
  min-height: 100vh;
}

.topBox {
  padding: 70rpx 20rpx 100rpx 50rpx;
  background-color: #2B73FF;
}

.hyzcText {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 62rpx;
  color: #FFFFFF;
  line-height: 62rpx;
}

.tipsText {
  margin-top: 20rpx;
  font-family: PingFang SC;
  font-weight: 400;
  font-size: 36rpx;
  color: #FFFFFF;
  line-height: 36rpx;
}

.cardBox {
  position: absolute;
  top: 380rpx;
  left: 0;
  width: 100vw;
  min-height: 1000rpx;
  background: #FFFFFF;
  border-radius: 60rpx 60rpx 0 0;
  padding: 80rpx 75rpx;
}

.labelText {
  margin-bottom: 20rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 30rpx;
  color: #545454;
  line-height: 60rpx;
}

.inputClass {
  margin-bottom: 20rpx;
  height: 86rpx;
  background: #F4F4F4;
  border-radius: 12rpx;
  padding-left: 45rpx;
}

.placeholderClass {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 30rpx;
  color: #545454;
  line-height: 60rpx;
  opacity: 0.2;
}

.phoneBtn {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin: 0 0 20rpx;
  padding: 0 0 0 45rpx;
  width: 100%;
  height: 86rpx;
  background: #F4F4F4;
  border-radius: 12rpx;
  border: none;
  line-height: 86rpx;
  text-align: left;
}

.phoneBtn::after {
  border: none;
}

.phoneText {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 30rpx;
  color: #545454;
  line-height: 86rpx;
}

.phonePlaceholder {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 30rpx;
  color: #545454;
  line-height: 86rpx;
  opacity: 0.2;
}

.submitClass {
  margin-top: 60rpx;
  height: 90rpx;
  background: #005DFF;
  border-radius: 11rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 30rpx;
  color: #FFFFFF;
  line-height: 30rpx;
}