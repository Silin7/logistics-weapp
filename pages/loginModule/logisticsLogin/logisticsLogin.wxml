<view class="purchaseLogin">
  <view class="topBox frbc">
    <view>
      <view class="hyzcText">欢迎注册</view>
      <view class="tipsText">登录后更精彩</view>
    </view>
    <image src="http://39.106.44.146/WULIU/loginWlqy.png" mode="" style="width: 380rpx; height: 275rpx;" />
  </view>
  <!-- 登录卡片 -->
  <view class="cardBox">
    <view class="labelText">手机号</view>
    <input value="{{ userPhone }}" class="inputClass" placeholder-class="placeholderClass" placeholder="请输入" bind:input="userPhoneInput" />
    <view class="labelText">手机号验证</view>
    <view class="pr">
      <!-- bind:input="verificationInput" -->
      <input value="{{ verificationCode }}" class="inputClass" placeholder-class="placeholderClass" placeholder="请输入" disabled />
      <view wx:if="{{ countdown < 60 && countdown > 0 }}" class="getCodeClass">获取验证码 ({{ countdown }})</view>
      <view wx:else class="getCodeClass" bind:tap="getcompanyphonecodeFunction">获取验证码</view>
    </view>
    <view class="labelText">姓名</view>
    <input value="{{ name }}" class="inputClass" placeholder-class="placeholderClass" placeholder="请输入" bind:input="nameInput" />
    <view class="labelText">录入车牌号</view>
    <input value="{{ numberplate }}" class="inputClass" placeholder-class="placeholderClass" placeholder="请输入" bind:input="carNumberInput" />
    <view class="labelText">上传驾驶证</view>
    <view class="frsc">
      <view style="margin-right: 28rpx;" bind:tap="chooseFiles" data-code="01">
        <image wx:if="{{ license_page }}" src="{{ license_page }}" mode="aspectFill" style="width: 265rpx; height: 168rpx;" />
        <image wx:else src="http://39.106.44.146/WULIU/login_jsz0.png" mode="aspectFit" style="width: 265rpx; height: 168rpx;" />
      </view>
      <view bind:tap="chooseFiles" data-code="02">
        <image wx:if="{{ license_subpage }}" src="{{ license_subpage }}" mode="aspectFill" style="width: 265rpx; height: 168rpx;" />
        <image wx:else src="http://39.106.44.146/WULIU/login_jsz1.png" mode="" style="width: 265rpx; height: 168rpx;" />
      </view>
    </view>
    <view class="submitClass frcc" bind:tap="submitFunction">提交</view>
  </view>
</view>