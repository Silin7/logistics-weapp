<scroll-view scroll-y="{{ true }}" refresher-enabled="{{ true }}" refresher-triggered="{{ triggered }}" bindrefresherrefresh="permessagerePull" bindscrolltolower="onScrollBottom" style="height: 100vh;">
  <view class="hetongList">
    <view wx:for="{{ dataList }}" wx:key="index" class="cardItem">
      <view class="hthText">客户：{{ item.t_company_name }}</view>
      <view class="ppText">单据编号：{{ item.voucherCode }}</view>
      <view class="ppText">单据日期：{{ item.created_at }}</view>
      <view class="btnsBox frac">
        <view wx:if="{{ item.haveimg === 0 }}" class="uploadBtn frcc" bind:tap="goUploadPage" data-item="{{ item }}" data-type="add">上传图片</view>
        <view wx:if="{{ item.haveimg === 1 }}" class="uploadBtn frcc" bind:tap="goViewPage" data-item="{{ item }}">查看图片</view>
        <view wx:if="{{ item.haveimg === 1 }}" class="updateBtn frcc" bind:tap="goUploadPage" data-item="{{ item }}" data-type="update">修改图片</view>
        <view class="qzqrBtn frcc" bind:tap="goDeliveryhavesigned" data-item="{{ item }}">让收货人签字</view>
      </view>
    </view>
    <view wx:if="{{ dataList.length === 0 }}" class="nodataBox">
      <image src="/images/systemModule/zwsj.png" mode="aspectFill" />
    </view>
  </view>
</scroll-view>