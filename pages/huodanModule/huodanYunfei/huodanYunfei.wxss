.hetongList {
  min-height: 100vh;
  padding: 20rpx;
  background-color: #F4F8FB;
}

.cardItem {
  margin-bottom: 20rpx;
  padding: 50rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 4rpx 19rpx 5rpx #cde6f3;
  border-radius: 10rpx;
}

.hthText {
  margin-bottom: 30rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #000000;
  line-height: 60rpx;
}

.ppText {
  margin-bottom: 10rpx;
  font-family: PingFang SC;
  font-weight: 400;
  font-size: 26rpx;
  color: #545454;
  line-height: 40rpx;
  overflow-wrap: break-word;
}

.yfText {
  color: #26D08A;
  font-weight: 700;
}