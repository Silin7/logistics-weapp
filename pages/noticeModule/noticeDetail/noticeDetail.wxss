.noticeDetailPage {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #F4F8FB;
}

.noticeCard {
  min-height: calc(100vh - 100rpx);
  padding: 70rpx 30rpx;
  background-color: #fff;
  background: #FFFFFF;
  border-radius: 10rpx;
}

.noticeTitle {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 38rpx;
  color: #000000;
  line-height: 60rpx;
}

.subText {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #545454;
  line-height: 60rpx;
  opacity: 0.6;
}

.henggang {
  margin: 30rpx 0 50rpx;
  height: 1rpx;
  border: 1px solid #E1E1E1;
}

.richTextBox {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #545454;
  line-height: 60rpx;
}