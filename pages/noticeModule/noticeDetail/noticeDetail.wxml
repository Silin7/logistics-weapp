<view class="noticeDetailPage">
  <view class="noticeCard">
    <view class="noticeTitle">
      {{noticeForm.title}}
    </view>
    <view class="frsc">
      <view class="subText">来源：{{noticeForm.fromwhere}}</view>
      <view class="subText ml20">{{noticeForm.created_at}}</view>
    </view>
    <view class="henggang"></view>
    <view class="richTextBox" bind:tap="richTextClick">
      <rich-text nodes="{{noticeForm.contents}}" />
    </view>
  </view>
</view>