<view class="webViewPage">
  <web-view src="{{ webUrl }}" header="cache-control: no-cache" style="position: relative;">
    <cover-view wx:if="{{ signed === 0 }}" class="btnStyle" bind:tap="goSignPage">
      签字
    </cover-view>
    <cover-view wx:if="{{ signed === 1 }}" class="btnStyle" bind:tap="goHomePage">
      回到首页
    </cover-view>
    <cover-view wx:if="{{ signed === 1 && pdfurl }}" class="btnStyle2" bind:tap="downloadPDF">
      合同下载
    </cover-view>
  </web-view>
