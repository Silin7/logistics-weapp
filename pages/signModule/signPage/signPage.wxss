page {
  box-sizing: border-box;
  overflow: hidden;
  height: 100vh;
  background: #F4F8FB;
  padding: 20rpx;
}

.wrapperPage {
  padding: 50rpx;
  width: 100%;
  height: 930rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background-color: #fff;
  box-shadow: 3rpx 4rpx 19rpx 5rpx #cde6f3;
}

.handWriting {
  background: #fff;
  width: 100%;
  height: 100%;
}

.handCenter {
  height: 600rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.handTitle {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #757373;
  line-height: 28rpx;
}

.handBtn {
  margin-top: 30rpx;
}

.delBtn {
  width: 236rpx;
  height: 80rpx;
  background: #C1C1C1;
  border-radius: 12rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}

.subBtn {
  width: 236rpx;
  height: 80rpx;
  background: #26D08A;
  border-radius: 12rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}