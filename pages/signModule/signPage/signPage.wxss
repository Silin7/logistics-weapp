page {
  box-sizing: border-box;
  background: #F4F8FB;
  padding: 10rpx;
  height: 100%;
}

.wrapperPage {
  padding: 20rpx 40rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background-color: #fff;
  box-shadow: 3rpx 4rpx 19rpx 5rpx #cde6f3;
}

.handWriting {
  background: #fff;
  width: 100%;
  height: 100%;
}

.handCenter {
  height: calc(100vh - 130rpx);
  overflow: hidden;
  box-sizing: border-box;
}

.handTitle {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 20rpx;
  color: #757373;
  line-height: 20rpx;
}

.handBtn {
  margin-top: 10rpx;
}

.delBtn {
  width: 126rpx;
  height: 40rpx;
  background: #C1C1C1;
  border-radius: 12rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 20rpx;
}

.subBtn {
  width: 126rpx;
  height: 40rpx;
  background: #26D08A;
  border-radius: 12rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 20rpx;
}