<view class="homePage">
  <!-- banner -->
  <view class="bannerBox">
    <swiper indicator-dots="{{ false }}" autoplay="{{ false }}" bindchange="swiperChange" style="height: 540rpx;">
      <block wx:for="{{ portalForm.adver_top }}" wx:key="index">
        <swiper-item>
          <image src="{{ item.theimg }}" mode="aspectFill" class="bannerImage" style="width: 100%; height: 540rpx;" />
        </swiper-item>
      </block>
    </swiper>
    <!-- banner - dian -->
    <view class="swiperDianBox frcc">
      <view wx:for="{{ portalForm.adver_top.length }}" wx:key="idnex">
        <view wx:if="{{ swiperCurrent === index }}" class="swiperDianA"></view>
        <view wx:else class="swiperDianN"></view>
      </view>
    </view>
    <!-- 登录box -->
    <view class="subBox frac">
    <!-- bind:tap="goLoginKhd" -->
      <view class="subItem" bind:tap="goHetongSearch">
        <image src="/images/homeModule/homecard1.png" mode="aspectFill" class="cardBgimg" />
        <view class="subTextBox frcc">
          <image src="/images/homeModule/homeIcon1.png" mode="aspectFill" style="width: 105rpx; height: 105rpx;" />
          <view style="margin-left: 10rpx;">
            <view class="sbuText1">客户端</view>
            <view class="sbuText2">合作商家登录</view>
          </view>
        </view>
      </view>
      <view class="dividerShu"></view>
      <view class="subItem" bind:tap="goLoginWld">
        <image src="/images/homeModule/homecard2.png" mode="aspectFill" class="cardBgimg" />
        <view class="subTextBox frcc">
          <image src="/images/homeModule/homeIcon2.png" mode="aspectFill" style="width: 105rpx; height: 105rpx;" />
          <view style="margin-left: 10rpx;">
            <view class="sbuText1">物流端</view>
            <view class="sbuText2">司机师傅登录</view>
          </view>
        </view>
      </view>
    </view>
    <!-- 广告位 -->
    <view class="advertisingSpace">
      <image src="{{ portalForm.adver_middle.theimg }}" mode="aspectFill" style="width: 100%; height: 100%;" />
    </view>
  </view>
  <!-- 通知公告 -->
  <view class="noticeBox">
    <view class="gonggaoTitleBox">
      <image src="/images/homeModule/gonggao.png" mode="aspectFill" style="width: 170rpx; height: 46rpx;" />
      <view class="frcc" bind:tap="goNoticeList">
        <view class="gengduoText">更多</view>
        <image src="/images/homeModule/homeMore.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
      </view>
    </view>
    <view wx:for="{{ portalForm.posts }}" wx:key="index" class="noticeItemBox" bind:tap="goNoticeDetail" data-item="{{ item }}">
      <view class="noticeItemTitle to1">{{ item.title }}</view>
      <view class="noticeItemContent to2">{{ item.description }}</view>
      <view class="noticeItemDate">{{ item.created_at }}</view>
    </view>
    <view wx:if="{{ portalForm.posts && portalForm.posts.length === 0 }}">
      <image src="/images/systemModule/zwsj.png" mode="aspectFill" />
    </view>
  </view>
</view>