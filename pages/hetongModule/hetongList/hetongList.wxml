<view class="hetongList">
  <view wx:for="{{ dataList }}" wx:key="index" class="cardItem">
    <view class="hthText">合同号：{{ item.voucherCode }}</view>
    <view class="ppText">产品品牌：{{ item.pinpai }}</view>
    <view class="ppText">签订日期：{{ item.voucherDate }}</view>
    <view class="qzqrBtn frcc" bind:tap="goVoucherhavesigned" data-item="{{ item }}">合同明细</view>
  </view>
  <view wx:if="{{ dataList.length === 0 }}" class="nodataBox">
    <image src="/images/systemModule/zwsj.png" mode="aspectFill" />
  </view>
</view>